function hBatG(a,p){const s=getSheet('batalhas');switch(a){case 'getAll':return json(sheetToArray(s));case 'getById':{const i=sheetToArray(s).find(x=>x.id===p.id);return i?json(i):err('Não encontrado',404);}case 'getByCoach':return json(sheetToArray(s).filter(x=>x.coach_id===p.coachId));default:return err('Ação: '+a,400);}}
function hBatP(a,body){const s=getSheet('batalhas');switch(a){case 'create':{const id=body.id||Utilities.getUuid();const o={id,nome:body.nome||'',coach_id:body.coach_id||'',simulado_id:body.simulado_id||'',data_fim:body.data_fim||'',tempo_limite:body.tempo_limite||'',status:'ativa',criada_em:new Date().toISOString()};appendRowObj(s,o);return json(o);}case 'update':return gUpdate(s,body);case 'delete':return gDelete(s,body);case 'encerrar':{if(!body.id)return err('ID obrigatório',400);const ri=findRowIndex(s,'id',body.id);if(ri===-1)return err('Não encontrado',404);const h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];const cr=s.getRange(ri,1,1,h.length).getValues()[0];const c={};h.forEach((hh,i)=>{c[hh]=cr[i];});c.status='encerrada';updateRow(s,ri,c);return json(c);}default:return err('Ação: '+a,400);}}

