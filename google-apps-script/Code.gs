function hFBP(a,body){const s=getSheet('feedback_simulado');switch(a){case 'save':{if(!body.tentativa_id)return err('tentativa_id obrigatório',400);const all=sheetToArray(s);const ex=all.find(x=>x.tentativa_id===body.tentativa_id);if(ex){const ri=findRowIndex(s,'id',ex.id);if(ri>0){const u={...ex,coach_id:body.coach_id||ex.coach_id,comentarios_questoes:body.comentarios_questoes?JSON.stringify(body.comentarios_questoes):(ex.comentarios_questoes||'[]'),orientacoes_gerais:body.orientacoes_gerais!==undefined?body.orientacoes_gerais:ex.orientacoes_gerais,sugestoes_conteudo:body.sugestoes_conteudo!==undefined?body.sugestoes_conteudo:ex.sugestoes_conteudo,temas_revisar:body.temas_revisar!==undefined?body.temas_revisar:ex.temas_revisar,status:body.status||ex.status,atualizado_em:new Date().toISOString(),enviado_em:body.status==='enviado'?new Date().toISOString():(ex.enviado_em||'')};updateRow(s,ri,u);return json(u);}}const id=Utilities.getUuid();const o={id,tentativa_id:body.tentativa_id,simulado_id:body.simulado_id||'',aluno_id:body.aluno_id||'',coach_id:body.coach_id||'',comentarios_questoes:body.comentarios_questoes?JSON.stringify(body.comentarios_questoes):'[]',orientacoes_gerais:body.orientacoes_gerais||'',sugestoes_conteudo:body.sugestoes_conteudo||'',temas_revisar:body.temas_revisar||'',status:body.status||'rascunho',criado_em:new Date().toISOString(),atualizado_em:new Date().toISOString(),enviado_em:body.status==='enviado'?new Date().toISOString():''};appendRowObj(s,o);return json(o);}case 'delete':return gDelete(s,body);default:return err('Ação: '+a,400);}}

